# Listen (containers / public hosts need 0.0.0.0)
HOST=0.0.0.0
PORT=8787

# Comma-separated API keys. Optional :plan suffix (free|builder). Default plan=free.
# Example: trk_live_abc:builder,trk_live_xyz:free
# Set this on the host (Render/Railway dashboard or shell export) — never commit real keys.
TOOLRANK_API_KEYS=trk_live_test:builder,trk_live_free_demo:free
